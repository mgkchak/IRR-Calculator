// ═══════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════
let rawData = [];
let allColumns = [];
let colTypes = {};
let selectedCols = new Set();
let lastResults = null;
let activeVersion = null; // 'as' | 'ig' | 'ff' | null

// ═══════════════════════════════════════════
// FILE LOADING
// ═══════════════════════════════════════════
const dropZone = document.getElementById('dropZone');
const fileInput = document.getElementById('fileInput');

dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
dropZone.addEventListener('drop', e => {
  e.preventDefault(); dropZone.classList.remove('drag-over'); handleFile(e.dataTransfer.files[0]);
});
fileInput.addEventListener('change', () => handleFile(fileInput.files[0]));

function handleFile(file) {
  if (!file) return;
  const ext = file.name.split('.').pop().toLowerCase();
  const reader = new FileReader();
  if (ext === 'xlsx' || ext === 'xls') {
    reader.onload = e => {
      const wb = XLSX.read(new Uint8Array(e.target.result), { type: 'array' });
      const ws = wb.Sheets[wb.SheetNames[0]];
      loadData(XLSX.utils.sheet_to_json(ws, { defval: '' }), file.name);
    };
    reader.readAsArrayBuffer(file);
  } else {
    reader.onload = e => {
      const text = e.target.result;
      const delim = ext === 'tsv' ? '\t' : detectDelim(text);
      const wb = XLSX.read(text, { type: 'string', FS: delim });
      const ws = wb.Sheets[wb.SheetNames[0]];
      loadData(XLSX.utils.sheet_to_json(ws, { defval: '' }), file.name);
    };
    reader.readAsText(file);
  }
}

function detectDelim(text) {
  const first = text.split('\n')[0];
  const t = (first.match(/\t/g)||[]).length;
  const c = (first.match(/,/g)||[]).length;
  const s = (first.match(/;/g)||[]).length;
  if (t >= c && t >= s) return '\t';
  if (s > c) return ';';
  return ',';
}

function loadData(data, filename) {
  rawData = data;
  allColumns = Object.keys(data[0] || {});
  colTypes = {};
  allColumns.forEach(c => { colTypes[c] = guessType(data, c); });

  dropZone.classList.add('file-loaded');
  document.getElementById('dropIcon').textContent = '✅';
  document.getElementById('dropText').innerHTML = `<strong>${filename}</strong>`;
  const prev = document.getElementById('filePreview');
  prev.classList.remove('hidden');
  prev.innerHTML = `<strong>${data.length}</strong> rows · <strong>${allColumns.length}</strong> columns detected`;

  // Auto-detect version
  const detected = detectVersion(allColumns);
  activeVersion = detected;

  document.getElementById('versionSection').style.display = '';
  renderVersionCards(detected);
  applyVersionAndRebuild(detected || 'as');

  document.getElementById('coderSection').style.display = '';
  document.getElementById('metricSection').style.display = '';
  document.getElementById('runSection').style.display = '';
}

function guessType(data, col) {
  const vals = data.map(r => r[col]).filter(v => v !== '' && v != null);
  const nums = vals.filter(v => !isNaN(Number(v)));
  if (nums.length > 0 && nums.length === vals.length) return 'interval';
  return 'nominal';
}

// ═══════════════════════════════════════════
// VERSION DETECTION & SELECTION
// ═══════════════════════════════════════════
function detectVersion(cols) {
  const colSet = new Set(cols);
  // Score each version by signature matches
  let best = null, bestScore = 0;
  for (const [key, def] of Object.entries(SHEET_VERSIONS)) {
    if (!def.signature.length) continue;
    const score = def.signature.filter(s => colSet.has(s)).length;
    if (score > bestScore) { bestScore = score; best = key; }
  }
  return best;
}

function renderVersionCards(detectedKey) {
  ['as','ig','ff'].forEach(k => {
    const card = document.getElementById(`card-${k}`);
    card.classList.remove('active');
    if (k !== 'ff') {
      card.onclick = () => {
        activeVersion = k;
        renderVersionCards(null);
        card.classList.add('active');
        applyVersionAndRebuild(k);
      };
    }
  });

  if (detectedKey && detectedKey !== 'ff') {
    document.getElementById(`card-${detectedKey}`).classList.add('active');
    const banner = document.getElementById('detectBanner');
    const msg = document.getElementById('detectMsg');
    banner.classList.add('visible');
    msg.textContent = `Auto-detected as "${SHEET_VERSIONS[detectedKey].name}" — verify or change above.`;
  } else if (!detectedKey) {
    document.getElementById('detectBanner').classList.remove('visible');
  }
}

function applyVersionAndRebuild(versionKey) {
  buildColumnSelectors(versionKey);
  document.getElementById('colSection').style.display = '';
}

// ═══════════════════════════════════════════
// COLUMN SELECTORS
// ═══════════════════════════════════════════
const FIXED_PAPER_COL = 'Research Question ID';
const FIXED_CODER_COL = 'Reviewer';
const EXCLUDED_CODERS = new Set(['string']); // lowercase for case-insensitive match

function buildColumnSelectors(versionKey) {
  buildColPicker(versionKey);
  buildCoderList();

  document.getElementById('selectAllBtn').onclick = () => {
    document.querySelectorAll('.col-check').forEach(cb => {
      if (!cb.checked) { cb.checked = true; cb.dispatchEvent(new Event('change')); }
    });
  };
  document.getElementById('clearAllBtn').onclick = () => {
    document.querySelectorAll('.col-check').forEach(cb => {
      if (cb.checked) { cb.checked = false; cb.dispatchEvent(new Event('change')); }
    });
  };
}

function buildColPicker(versionKey) {
  const paperCol = FIXED_PAPER_COL;
  const coderCol = FIXED_CODER_COL;
  const exclude = new Set([paperCol, coderCol]);

  // Determine which cols to pre-select
  const versionCols = versionKey && SHEET_VERSIONS[versionKey]
    ? new Set(SHEET_VERSIONS[versionKey].cols) : new Set();

  // Filter: only pre-check cols that are in the version definition AND present in the file
  // AND: for metric columns, only if at least one coder has a non-empty value
  const metricsWithData = versionKey ? getMetricColsWithData(versionKey, coderCol, paperCol) : new Set(allColumns);

  const picker = document.getElementById('colPicker');
  picker.innerHTML = '';
  selectedCols.clear();

  allColumns.filter(c => !exclude.has(c)).forEach(c => {
    const type = colTypes[c] || 'nominal';
    const isMetricCol = /^Metric\d+-/.test(c);
    const shouldPreCheck = versionCols.has(c) &&
      (!isMetricCol || metricsWithData.has(c));

    const wrap = document.createElement('div');

    const item = document.createElement('label');
    item.className = 'col-item';
    item.innerHTML = `
      <input type="checkbox" class="col-check" data-col="${esc(c)}" ${shouldPreCheck ? 'checked' : ''}>
      <span class="col-name" title="${esc(c)}">${c.length > 28 ? c.slice(0,26)+'…' : c}</span>
      <span class="col-type-badge ${type.slice(0,3)}">${type.slice(0,3).toUpperCase()}</span>
    `;

    const typeRow = document.createElement('div');
    typeRow.className = `col-type-selector${shouldPreCheck ? ' visible' : ''}`;
    ['nominal','ordinal','interval'].forEach(t => {
      const btn = document.createElement('button');
      btn.className = `type-btn ${type === t ? 'active-'+t.slice(0,3) : ''}`;
      btn.textContent = t; btn.dataset.type = t;
      btn.addEventListener('click', e => {
        e.preventDefault();
        colTypes[c] = t;
        typeRow.querySelectorAll('.type-btn').forEach(b => {
          b.className = `type-btn ${b.dataset.type === t ? 'active-'+t.slice(0,3) : ''}`;
        });
        item.querySelector('.col-type-badge').className = `col-type-badge ${t.slice(0,3)}`;
        item.querySelector('.col-type-badge').textContent = t.slice(0,3).toUpperCase();
      });
      typeRow.appendChild(btn);
    });

    if (shouldPreCheck) selectedCols.add(c);

    item.querySelector('.col-check').addEventListener('change', function() {
      if (this.checked) { selectedCols.add(c); typeRow.classList.add('visible'); }
      else { selectedCols.delete(c); typeRow.classList.remove('visible'); }
      updatePickerCount();
    });

    wrap.appendChild(item); wrap.appendChild(typeRow); picker.appendChild(wrap);
  });

  updatePickerCount();
}

// For metric columns: only include if at least one row has a non-empty value for that column
function getMetricColsWithData(versionKey, coderCol, paperCol) {
  const result = new Set();
  const vDef = SHEET_VERSIONS[versionKey];
  if (!vDef) return result;

  vDef.cols.forEach(col => {
    if (!/^Metric\d+-/.test(col)) {
      result.add(col); // always include non-metric cols
      return;
    }
    // Check if any row has a non-empty value
    const hasData = rawData.some(row => {
      const v = row[col];
      return v !== undefined && v !== null && String(v).trim() !== '';
    });
    if (hasData) result.add(col);
  });

  return result;
}

function updatePickerCount() {
  document.getElementById('pickerCount').textContent = `${selectedCols.size} selected`;
}

function buildCoderList() {
  const coderMulti = document.getElementById('coderMulti');
  coderMulti.innerHTML = '';

  const coders = [...new Set(
    rawData
      .map(r => String(r[FIXED_CODER_COL] ?? '').trim())
      .filter(v => v && !EXCLUDED_CODERS.has(v.toLowerCase()))
  )];

  coders.forEach(coder => {
    const label = document.createElement('label');
    label.className = 'col-item';
    label.style.padding = '5px 6px';
    label.innerHTML = `<input type="checkbox" class="coder-check" value="${esc(coder)}" checked>
      <span class="col-name">${coder}</span>`;
    coderMulti.appendChild(label);
  });

  // remove stale listener then re-add
  const fc = document.getElementById('filterCoders');
  const newFc = fc.cloneNode(true);
  fc.parentNode.replaceChild(newFc, fc);
  newFc.addEventListener('change', function() {
    coderMulti.classList.toggle('visible', this.checked);
  });
}

function esc(s) { return String(s).replace(/"/g,'&quot;'); }

// ═══════════════════════════════════════════
// METRIC UI
// ═══════════════════════════════════════════
document.querySelectorAll('.metric-item').forEach(item => {
  item.addEventListener('change', () => {
    item.classList.toggle('selected', item.querySelector('input').checked);
  });
});

// ═══════════════════════════════════════════
// RUN
// ═══════════════════════════════════════════
document.getElementById('runBtn').addEventListener('click', () => {
  const paperCol = FIXED_PAPER_COL;
  const coderCol = FIXED_CODER_COL;
  const cols = [...selectedCols];
  const metrics = getSelectedMetrics();

  const errors = [];
  if (cols.length === 0) errors.push('Please select at least one coding column.');
  if (metrics.length === 0) errors.push('Please select at least one metric.');
  if (errors.length) { showResults(null, errors, []); return; }

  let wideData = parseLong(rawData, paperCol, coderCol, cols);

  // Remove excluded coder values (e.g. "String" artifact)
  Object.keys(wideData).forEach(pid => {
    Object.keys(wideData[pid]).forEach(cid => {
      if (EXCLUDED_CODERS.has(cid.toLowerCase())) delete wideData[pid][cid];
    });
  });

  const filterOn = document.getElementById('filterCoders').checked;
  if (filterOn) {
    const allowed = new Set([...document.querySelectorAll('.coder-check:checked')].map(el => el.value));
    Object.keys(wideData).forEach(pid => {
      wideData[pid] = Object.fromEntries(Object.entries(wideData[pid]).filter(([cid]) => allowed.has(cid)));
    });
  }

  const ARTIFACT_ROW = 'numerical (index identifier)';
  const papers = Object.keys(wideData).filter(pid => {
    const t = pid.trim();
    if (!t) return false;
    if (/^\d+$/.test(t)) return false; // bare integer artifact rows
    if (t.toLowerCase() === ARTIFACT_ROW) return false;
    return true;
  });
  const coders = [...new Set(papers.flatMap(p => Object.keys(wideData[p])))];
  const nCoders = coders.length;

  const metricErrors = {}, metricWarnings = {};
  metrics.forEach(m => {
    metricErrors[m] = []; metricWarnings[m] = [];
    if (m === 'cohen' && nCoders !== 2)
      metricErrors[m].push(`Cohen's Kappa requires exactly 2 coders. Found ${nCoders}: ${coders.join(', ')}.`);
    if (m === 'fleiss' && nCoders < 3)
      metricErrors[m].push(`Fleiss' Kappa requires 3+ coders. Found ${nCoders}.`);
    if (m === 'pairwise') {
      const nP = (nCoders*(nCoders-1))/2;
      if (nP > 45) metricWarnings[m].push(`${nCoders} coders → ${nP} pairs. Displaying aggregated results.`);
    }
  });

  const rqResults = {};
  cols.forEach(col => {
    rqResults[col] = {};
    metrics.forEach(m => {
      rqResults[col][m] = metricErrors[m].length ? null : calcMetric(m, wideData, papers, coders, col);
    });
  });

  const paperResults = {};
  papers.forEach(pid => {
    paperResults[pid] = {};
    metrics.forEach(m => {
      if (metricErrors[m].length) { paperResults[pid][m] = null; return; }
      const vals = cols.map(c => calcMetric(m, {[pid]: wideData[pid]}, [pid], coders, c)).filter(v => v !== null);
      paperResults[pid][m] = vals.length ? avg(vals) : null;
    });
  });

  const paperIndexMap = {};
  const paperLabelMap = {}; // rqId -> truncated Research Question text (for display)
  const rqTextFull = {}; // rqId -> full Research Question text (for export)
  const RQ_TEXT_COL = 'Research Question';
  papers.forEach((pid, i) => {
    paperIndexMap[pid] = i + 1;
    const matchRow = rawData.find(row => String(row[paperCol]) === pid);
    const rqText = matchRow && matchRow[RQ_TEXT_COL]
      ? String(matchRow[RQ_TEXT_COL]).trim() : '';
    rqTextFull[pid] = rqText;
    paperLabelMap[pid] = rqText.length > 52 ? rqText.slice(0, 50) + '…' : rqText;
  });

  // Build RQ ID grouped results: rqId -> { m -> avg IRR across papers in that RQ }
  const RQ_COL = 'Research Question ID';
  const rqIdResults = {};
  const rqIdPapers = {}; // rqId -> Set of pids

  if (paperCol === RQ_COL) {
    papers.forEach(pid => {
      if (!rqIdPapers[pid]) rqIdPapers[pid] = new Set();
      rqIdPapers[pid].add(pid);
    });
  } else if (allColumns.includes(RQ_COL)) {
    rawData.forEach(row => {
      const pid = String(row[paperCol]);
      const rqId = row[RQ_COL] !== undefined && String(row[RQ_COL]).trim() !== ''
        ? String(row[RQ_COL]).trim() : null;
      if (!rqId || !wideData[pid] || !papers.includes(pid)) return;
      if (!rqIdPapers[rqId]) rqIdPapers[rqId] = new Set();
      rqIdPapers[rqId].add(pid);
    });
  }

  Object.entries(rqIdPapers).forEach(([rqId, pidSet]) => {
    const rqPapers = [...pidSet];
    rqIdResults[rqId] = {};
    metrics.forEach(m => {
      if (metricErrors[m].length) { rqIdResults[rqId][m] = null; return; }
      const vals = rqPapers.map(pid => paperResults[pid][m]).filter(v => v !== null);
      rqIdResults[rqId][m] = vals.length ? avg(vals) : null;
    });
  });

  // ── Build true Paper-level grouping using Paper ID column ──
  const PAPER_ID_COL = 'Paper ID';
  const PAPER_TITLE_COL = 'Paper Title';
  const paperGroupResults = {};
  const paperGroupTitle = {};
  const paperGroupTitleFull = {};
  const paperGroupRQs = {};

  if (paperCol === PAPER_ID_COL) {
    // paperCol IS Paper ID — each pid in papers is already a paper number
    // Use paperResults directly; grab title from rawData
    papers.forEach(pid => {
      paperGroupResults[pid] = paperResults[pid];
      paperGroupRQs[pid] = [pid];
      const matchRow = rawData.find(row => String(row[paperCol]) === pid);
      const title = matchRow && matchRow[PAPER_TITLE_COL]
        ? String(matchRow[PAPER_TITLE_COL]).trim() : '';
      paperGroupTitleFull[pid] = title;
      paperGroupTitle[pid] = title.length > 50 ? title.slice(0, 48) + '…' : title;
    });
  } else if (allColumns.includes(PAPER_ID_COL)) {
    // paperCol is Research Question ID — group RQ pids by their Paper ID
    const paperNumToRQs = {};
    rawData.forEach(row => {
      const rqPid = String(row[paperCol]);
      if (!papers.includes(rqPid)) return;
      const paperNum = String(row[PAPER_ID_COL]).trim();
      if (!paperNum) return;
      if (!paperNumToRQs[paperNum]) paperNumToRQs[paperNum] = new Set();
      paperNumToRQs[paperNum].add(rqPid);
      if (!paperGroupTitleFull[paperNum]) {
        const title = row[PAPER_TITLE_COL] ? String(row[PAPER_TITLE_COL]).trim() : '';
        paperGroupTitleFull[paperNum] = title;
        paperGroupTitle[paperNum] = title.length > 50 ? title.slice(0, 48) + '…' : title;
      }
    });
    Object.entries(paperNumToRQs).forEach(([paperNum, rqSet]) => {
      const rqList = [...rqSet];
      paperGroupRQs[paperNum] = rqList;
      paperGroupResults[paperNum] = {};
      metrics.forEach(m => {
        if (metricErrors[m].length) { paperGroupResults[paperNum][m] = null; return; }
        const vals = rqList.map(pid => paperResults[pid][m]).filter(v => v !== null);
        paperGroupResults[paperNum][m] = vals.length ? avg(vals) : null;
      });
    });
  }

  lastResults = { rqResults, paperResults, rqIdResults, rqIdPapers,
    paperIndexMap, paperLabelMap, _rqTextFull: rqTextFull,
    paperGroupResults, paperGroupTitle, paperGroupTitleFull, paperGroupRQs,
    cols, papers, coders, metrics, metricErrors, metricWarnings,
    _wide: wideData };
  showResults(lastResults, [], []);
});

function getSelectedMetrics() {
  return [...document.querySelectorAll('[data-metric]')].filter(el => el.checked).map(el => el.dataset.metric);
}

// ═══════════════════════════════════════════
// DATA PARSING
// ═══════════════════════════════════════════
function parseLong(data, paperCol, coderCol, cols) {
  const wide = {};
  data.forEach(row => {
    const pid = String(row[paperCol]);
    const cid = String(row[coderCol]);
    if (!wide[pid]) wide[pid] = {};
    if (!wide[pid][cid]) wide[pid][cid] = {};
    cols.forEach(c => { wide[pid][cid][c] = row[c]; });
  });
  return wide;
}

function parseWide(data, paperCol, cols) {
  const wide = {};
  data.forEach(row => {
    const pid = String(row[paperCol]);
    if (!wide[pid]) wide[pid] = {};
    cols.forEach(c => {
      if (!wide[pid][c]) wide[pid][c] = {};
      wide[pid][c][c] = row[c];
    });
  });
  return wide;
}

// ═══════════════════════════════════════════
// IRR MATH
// ═══════════════════════════════════════════
function avg(arr) { return arr.reduce((a,b) => a+b, 0)/arr.length; }

function calcMetric(metric, wideData, papers, coders, col) {
  const matrix = coders.map(coder =>
    papers.map(paper => {
      const v = wideData[paper]?.[coder]?.[col];
      return (v === '' || v == null) ? null : v;
    })
  );
  if (metric === 'alpha')    return krippendorffAlpha(matrix, colTypes[col] || 'nominal');
  if (metric === 'pairwise') return pairwiseAgreement(matrix);
  if (metric === 'cohen')    return cohensKappa(matrix);
  if (metric === 'fleiss')   return fleissKappa(matrix, papers);
  return null;
}

function pairwiseAgreement(matrix) {
  const n = matrix[0].length;
  const pairs = [];
  for (let i = 0; i < matrix.length; i++) {
    for (let j = i+1; j < matrix.length; j++) {
      let agree = 0, total = 0;
      for (let k = 0; k < n; k++) {
        const a = matrix[i][k], b = matrix[j][k];
        if (a !== null && b !== null) { total++; if (String(a) === String(b)) agree++; }
      }
      if (total > 0) pairs.push(agree/total);
    }
  }
  return pairs.length ? avg(pairs) : null;
}

function cohensKappa(matrix) {
  if (matrix.length !== 2) return null;
  const [a, b] = matrix;
  const n = a.length;
  const cats = [...new Set([...a,...b].filter(v=>v!==null).map(String))];
  const valid = a.map((v,i) => v!==null && b[i]!==null);
  const N = valid.filter(Boolean).length;
  if (N === 0 || cats.length === 0) return null;
  let po = 0;
  for (let i = 0; i < n; i++) if (valid[i] && String(a[i])===String(b[i])) po++;
  po /= N;
  let pe = 0;
  cats.forEach(c => {
    const pa = a.filter((v,i)=>valid[i]&&String(v)===c).length/N;
    const pb = b.filter((v,i)=>valid[i]&&String(v)===c).length/N;
    pe += pa*pb;
  });
  return pe >= 1 ? 1 : (po-pe)/(1-pe);
}

function fleissKappa(matrix, papers) {
  const nR = matrix.length, nI = papers.length;
  const catSet = new Set();
  matrix.forEach(row => row.forEach(v => { if (v!==null) catSet.add(String(v)); }));
  const cats = [...catSet];
  if (!cats.length) return null;

  const nij = papers.map((_,i) => {
    const counts = Object.fromEntries(cats.map(c=>[c,0]));
    matrix.forEach(row => { if (row[i]!==null) { const s=String(row[i]); if(counts[s]!==undefined) counts[s]++; } });
    return counts;
  });
  const ni = nij.map(row => Object.values(row).reduce((a,b)=>a+b,0));
  const N = ni.reduce((a,b)=>a+b,0);
  if (!N) return null;

  const Pi = nij.map((row,i) => {
    const t = ni[i]; if (t<=1) return 0;
    return cats.reduce((acc,c)=>acc+row[c]*(row[c]-1),0)/(t*(t-1));
  });
  const Pbar = avg(Pi);
  const Pj = cats.map(c => nij.reduce((acc,row)=>acc+row[c],0)/N);
  const Pe = Pj.reduce((acc,p)=>acc+p*p,0);
  return Pe>=1 ? 1 : (Pbar-Pe)/(1-Pe);
}

function krippendorffAlpha(matrix, dataType) {
  const nI = matrix[0].length;
  const values = [];
  matrix.forEach((row,o) => row.forEach((v,i) => {
    if (v!==null) values.push({o,i,v:parseVal(v)});
  }));
  if (values.length < 2) return null;

  const allVals = [...new Set(values.map(d=>d.v))].sort((a,b)=>a>b?1:-1);
  const coincidences = {}, mu = {};
  allVals.forEach(v => mu[v]=0);
  let totalPairs = 0;

  for (let i = 0; i < nI; i++) {
    const iv = values.filter(d=>d.i===i);
    const n = iv.length; if (n<2) continue;
    for (let a = 0; a < iv.length; a++) {
      for (let b = 0; b < iv.length; b++) {
        if (a===b) continue;
        const va=iv[a].v, vb=iv[b].v, w=1/(n-1);
        const key=`${va}__${vb}`;
        coincidences[key]=(coincidences[key]||0)+w;
        mu[va]=(mu[va]||0)+w;
        totalPairs+=w;
      }
    }
  }
  if (!totalPairs) return null;

  let Do=0;
  allVals.forEach(vk=>allVals.forEach(vl=>{
    Do+=delta(vk,vl,dataType,allVals)*(coincidences[`${vk}__${vl}`]||0);
  }));
  Do/=totalPairs;

  const muTotal=Object.values(mu).reduce((a,b)=>a+b,0);
  let De=0;
  allVals.forEach(vk=>allVals.forEach(vl=>{
    De+=delta(vk,vl,dataType,allVals)*(mu[vk]||0)*(mu[vl]||0);
  }));
  De/=(muTotal*(muTotal-1));

  return De===0 ? 1 : 1-Do/De;
}

function parseVal(v) { const n=Number(v); return isNaN(n)?String(v):n; }

function delta(vk,vl,dataType,allVals) {
  if (String(vk)===String(vl)) return 0;
  if (dataType==='nominal') return 1;
  if (dataType==='ordinal') {
    const ki=allVals.indexOf(vk),li=allVals.indexOf(vl);
    if (ki===-1||li===-1) return 1;
    return Math.pow(Math.abs(ki-li),2);
  }
  const nk=Number(vk),nl=Number(vl);
  return (isNaN(nk)||isNaN(nl)) ? 1 : Math.pow(nk-nl,2);
}

// ═══════════════════════════════════════════
// DISPLAY
// ═══════════════════════════════════════════
const METRIC_LABELS = {
  alpha:"Krippendorff's α", pairwise:'Pairwise %', cohen:"Cohen's κ", fleiss:"Fleiss' κ"
};

function fmtVal(v, isP) {
  if (v===null||v===undefined) return '<span class="val-na">—</span>';
  const n = isP ? v*100 : v;
  const cls = n>=(isP?80:0.8)?'val-good':n>=(isP?60:0.6)?'val-fair':'val-poor';
  return `<span class="${cls}">${n.toFixed(isP?1:3)}${isP?'%':''}</span>`;
}
function scoreClass(v) { return v===null?'na':v>=0.8?'good':v>=0.6?'fair':'poor'; }
function scoreInterp(v) {
  if (v===null) return 'N/A';
  return v>=0.8?'● Strong':v>=0.6?'◐ Moderate':'○ Low';
}

function showResults(res, errors, warnings) {
  const area = document.getElementById('resultsArea');
  document.getElementById('emptyState').classList.add('hidden');
  area.classList.remove('hidden');
  area.innerHTML = '';

  errors.forEach(e => area.innerHTML += banner('error','✖',e));
  if (!res) return;

  const {rqResults, paperResults, rqIdResults, rqIdPapers,
         paperIndexMap, paperLabelMap, paperGroupResults, paperGroupTitle, paperGroupRQs,
         cols, papers, coders, metrics, metricErrors, metricWarnings, _wide} = res;

  metrics.forEach(m => {
    metricErrors[m].forEach(e => area.innerHTML += banner('error','✖',`<strong>${METRIC_LABELS[m]}:</strong> ${e}`));
    metricWarnings[m].forEach(w => area.innerHTML += banner('warn','⚠',`<strong>${METRIC_LABELS[m]}:</strong> ${w}`));
  });

  const active = metrics.filter(m => !metricErrors[m].length);
  const vName = activeVersion ? SHEET_VERSIONS[activeVersion].name : '';
  const ts = new Date().toLocaleString();

  // ── Header ──
  const hdr = document.createElement('div');
  hdr.className = 'results-header';
  hdr.innerHTML = `
    <div>
      <div class="results-title">IRR Results <span class="info-tooltip">ℹ<span class="tooltip-body"><strong>Methodology note</strong><br>Krippendorff's Alpha uses the coincidence-matrix method (nominal by default). Validated against the krippendorff Python package. Per-RQ IRR = average of per-column Alpha values for that RQ. Overall = average of per-RQ values. Empty cells are treated as missing and excluded from calculations.</span></span></div>
      <div class="results-meta">${vName ? vName+' · ' : ''}${papers.length} papers · ${cols.length} variables · ${coders.length} coders · ${ts}</div>
    </div>
    <div class="export-btns">
      <button class="export-btn" onclick="exportCSV()">⬇ Export CSV</button>
      <button class="export-btn" onclick="exportXLSX()">⬇ Export Excel</button>
    </div>`;
  area.appendChild(hdr);

  if (!active.length) return;

  // ── 1. OVERALL SUMMARY ──
  // Overall average = avg of per-paper IRR (matches By Paper ID cards and export)
  const paperNums = Object.keys(paperGroupResults).sort((a,b) => {
    const na=parseFloat(a), nb=parseFloat(b);
    return isNaN(na)||isNaN(nb) ? a.localeCompare(b) : na-nb;
  });
  const overallAvg = {};
  active.forEach(m => {
    const vals = paperNums.map(p => paperGroupResults[p][m]).filter(v => v !== null);
    overallAvg[m] = vals.length ? avg(vals) : null;
  });

  const rqIds = Object.keys(rqIdResults).sort((a,b) => {
    // Sort RQ IDs naturally: 1.1, 1.2, 2.1, etc.
    const na = a.split('.').map(Number), nb = b.split('.').map(Number);
    for (let i = 0; i < Math.max(na.length, nb.length); i++) {
      const d = (na[i]||0) - (nb[i]||0);
      if (d !== 0) return d;
    }
    return 0;
  });
  const showRQCards = rqIds.length > 0;

  const sb = document.createElement('div');
  sb.className = 'metric-block';

  // Header
  let sh = `<div class="metric-block-header">
    <span class="metric-block-title">Overall Summary</span>
    <span class="metric-block-sub">Average IRR · ${paperNums.length} paper${paperNums.length!==1?'s':''}</span>
  </div>`;

  // Side-by-side body
  sh += '<div class="summary-body">';

  // LEFT: overall score cells stacked
  sh += '<div class="summary-left">';
  active.forEach(m => {
    const ov = overallAvg[m];
    const isP = m === 'pairwise';
    const disp = ov !== null ? (isP ? (ov*100).toFixed(1)+'%' : ov.toFixed(3)) : '—';
    sh += `<div class="score-cell" style="flex:1;border-bottom:1px solid var(--border);">
      <span class="score-value ${scoreClass(ov)}">${disp}</span>
      <span class="score-label">${METRIC_LABELS[m]}</span>
      <span class="score-interp">${scoreInterp(ov)}</span>
    </div>`;
  });
  sh += '</div>'; // end summary-left

  // RIGHT: subheading + scrollable Paper cards
  sh += '<div class="summary-right">';
  sh += `<div class="summary-right-label">By Paper ID</div>`;
  sh += '<div class="rq-cards-scroll">';
  if (paperNums.length > 0) {
    paperNums.forEach(paperNum => {
      const title = paperGroupTitle[paperNum] || '';
      sh += `<div class="score-cell-rq">
        <div class="score-rq-id" style="font-size:12px;font-weight:700;color:var(--text);">Paper ${paperNum}</div>
        ${title ? `<div style="font-family:var(--mono);font-size:9px;color:var(--text-faint);margin-bottom:6px;line-height:1.4;max-width:180px;">${title}</div>` : ''}`;
      active.forEach(m => {
        const v = paperGroupResults[paperNum][m];
        const isP = m === 'pairwise';
        const disp = v !== null ? (isP ? (v*100).toFixed(1)+'%' : v.toFixed(3)) : '—';
        sh += `<div class="score-metric-row">
          <span class="score-mini-val ${scoreClass(v)}">${disp}</span>
          <span class="score-mini-label">${METRIC_LABELS[m]}</span>
        </div>`;
      });
      sh += '</div>';
    });
  } else {
    // Fallback: use RQ-level papers if no Paper ID column
    papers.forEach(pid => {
      const label = paperLabelMap[pid] || '';
      sh += `<div class="score-cell-rq">
        <div class="score-rq-id" style="font-size:12px;font-weight:700;color:var(--text);">${pid}</div>
        ${label ? `<div style="font-family:var(--mono);font-size:9px;color:var(--text-faint);margin-bottom:6px;line-height:1.4;max-width:180px;">${label}</div>` : ''}`;
      active.forEach(m => {
        const v = paperResults[pid][m];
        const isP = m === 'pairwise';
        const disp = v !== null ? (isP ? (v*100).toFixed(1)+'%' : v.toFixed(3)) : '—';
        sh += `<div class="score-metric-row">
          <span class="score-mini-val ${scoreClass(v)}">${disp}</span>
          <span class="score-mini-label">${METRIC_LABELS[m]}</span>
        </div>`;
      });
      sh += '</div>';
    });
  }
  sh += '</div>'; // end rq-cards-scroll
  sh += '</div>'; // end summary-right
  sh += '</div>'; // end summary-body

  sb.innerHTML = sh;
  area.appendChild(sb);

  // ── 2. PAPER-LEVEL TABLE with expandable RQ rows ──
  const pb = document.createElement('div');
  pb.className = 'metric-block';

  const papAvg = active.map(m => {
    const v = papers.map(p => paperResults[p][m]).filter(v => v !== null);
    return v.length ? avg(v) : null;
  });

  let ph = `
    <div class="section-header">
      Research Question-Level IRR
      <span class="pill">${papers.length} papers</span>
      <span class="pill" style="color:var(--accent);border-color:rgba(107,138,253,.3)">▶ click row for variable detail</span>
    </div>
    <div class="rq-table-wrap"><table>
    <thead><tr>
      <th>${FIXED_PAPER_COL}</th>
      ${active.map(m=>`<th>${METRIC_LABELS[m]}</th>`).join('')}
    </tr></thead><tbody>`;

  const tc = {nominal:'nom',ordinal:'ord',interval:'int'};
  const tm = {nominal:'NOM',ordinal:'ORD',interval:'INT'};

  papers.forEach((pid, pi) => {
    const rowId = `rq-expand-${pi}`;
    const idx = paperIndexMap[pid];
    const label = paperLabelMap[pid];
    // Display: RQ ID + research question label chip (no numeric index in display)
    const labelChip = label
      ? `<span class="paper-index" title="${label}">${label}</span>`
      : '';
    const pidDisplay = `${pid}${labelChip}`;

    ph += `<tr class="paper-row" data-target="${rowId}">
      <td style="font-family:var(--mono)">${pidDisplay}</td>
      ${active.map(m=>`<td>${fmtVal(paperResults[pid][m],m==='pairwise')}</td>`).join('')}
    </tr>`;

    let innerRows = '';
    cols.forEach(col => {
      const t = colTypes[col]||'nominal';
      const perPaperColVals = active.map(m =>
        metricErrors[m].length ? null : calcMetric(m, {[pid]: _wide[pid]}, [pid], coders, col)
      );
      innerRows += `<tr>
        <td style="font-family:var(--mono);max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-left:28px" title="${col}">${col}</td>
        <td><span class="col-type-badge ${tc[t]}">${tm[t]}</span></td>
        ${perPaperColVals.map((v,i)=>`<td>${fmtVal(v,active[i]==='pairwise')}</td>`).join('')}
      </tr>`;
    });

    ph += `<tr class="rq-expand-row" id="${rowId}">
      <td class="rq-expand-cell" colspan="${1 + active.length}">
        <div class="rq-inner">
          <div class="rq-inner-header">Variable-level IRR · ${pid}${label ? ' — '+label : ''}</div>
          <div class="rq-table-wrap"><table>
            <thead><tr>
              <th>Variable</th><th>Type</th>
              ${active.map(m=>`<th>${METRIC_LABELS[m]}</th>`).join('')}
            </tr></thead>
            <tbody>${innerRows}</tbody>
          </table></div>
        </div>
      </td>
    </tr>`;
  });

  ph += `<tr style="background:var(--surface3)">
    <td style="font-weight:600;font-family:var(--mono)">AVERAGE</td>
    ${papAvg.map((v,i)=>`<td>${fmtVal(v,active[i]==='pairwise')}</td>`).join('')}
  </tr>`;
  ph += '</tbody></table></div>';
  pb.innerHTML = ph;

  pb.querySelectorAll('.paper-row').forEach(row => {
    row.addEventListener('click', () => {
      const target = document.getElementById(row.dataset.target);
      const isOpen = target.classList.contains('visible');
      pb.querySelectorAll('.rq-expand-row.visible').forEach(r => r.classList.remove('visible'));
      pb.querySelectorAll('.paper-row.expanded').forEach(r => r.classList.remove('expanded'));
      if (!isOpen) {
        target.classList.add('visible');
        row.classList.add('expanded');
      }
    });
  });

  area.appendChild(pb);

  // ── 3. PAIRWISE DETAIL (collapsible) ──
  if (active.includes('pairwise') && coders.length >= 2) {
    const pairs = [];
    for (let i=0;i<coders.length;i++) for (let j=i+1;j<coders.length;j++) pairs.push([coders[i],coders[j]]);
    const pairBlock = document.createElement('div');
    pairBlock.className = 'metric-block';

    let pairHtml = `<div class="section-toggle-header" id="pairToggleHdr">
      Pairwise Agreement Detail
      <span class="pill">${pairs.length} pair${pairs.length>1?'s':''}</span>
      <span class="toggle-arrow">▼</span>
    </div>
    <div class="section-toggle-body" id="pairToggleBody">
      <div class="rq-table-wrap"><table>
      <thead><tr><th>Pair</th>${cols.map(c=>`<th title="${c}">${c.length>14?c.slice(0,12)+'…':c}</th>`).join('')}<th>Avg</th></tr></thead><tbody>`;

    pairs.forEach(([ca,cb]) => {
      const colVals = cols.map(col => {
        const mat = [[],[]];
        papers.forEach(p => {
          mat[0].push(_wide[p]?.[ca]?.[col]??null);
          mat[1].push(_wide[p]?.[cb]?.[col]??null);
        });
        return pairwiseAgreement(mat);
      });
      const rowAvg = colVals.filter(v=>v!==null).length ? avg(colVals.filter(v=>v!==null)) : null;
      pairHtml += `<tr>
        <td><span class="pair-badge">👤 ${ca} × ${cb}</span></td>
        ${colVals.map(v=>`<td>${fmtVal(v,true)}</td>`).join('')}
        <td>${fmtVal(rowAvg,true)}</td>
      </tr>`;
    });

    pairHtml += '</tbody></table></div></div>';
    pairBlock.innerHTML = pairHtml;

    pairBlock.querySelector('#pairToggleHdr').addEventListener('click', () => {
      pairBlock.querySelector('#pairToggleHdr').classList.toggle('open');
      pairBlock.querySelector('#pairToggleBody').classList.toggle('open');
    });

    area.appendChild(pairBlock);
  }
}

function banner(type,icon,msg) {
  return `<div class="banner ${type}"><span class="banner-icon">${icon}</span><span>${msg}</span></div>`;
}

// ═══════════════════════════════════════════
// EXPORT
// ═══════════════════════════════════════════
function exportCSV() {
  if (!lastResults) return;
  const {paperGroupResults, paperGroupTitleFull,
         papers, metrics, metricErrors} = lastResults;
  const active = metrics.filter(m=>!metricErrors[m].length);

  const paperNums = Object.keys(paperGroupResults).sort((a,b)=>{
    const na=parseFloat(a),nb=parseFloat(b); return isNaN(na)||isNaN(nb)?a.localeCompare(b):na-nb;
  });

  // Overall = average of paperGroupResults (matches display)
  const overallAvg = {};
  active.forEach(m => {
    const vals = paperNums.map(p=>paperGroupResults[p][m]).filter(v=>v!==null);
    overallAvg[m] = vals.length ? avg(vals) : null;
  });

  const metricHeaders = active.map(m => METRIC_LABELS[m]);
  const lines = [];

  // Overall Summary
  lines.push(['OVERALL SUMMARY', ...metricHeaders].join(','));
  lines.push(['Overall IRR', ...active.map(m => {
    const v = overallAvg[m];
    return v !== null ? (m==='pairwise'?(v*100).toFixed(1)+'%':v.toFixed(4)) : 'N/A';
  })].join(','));
  lines.push('');

  // By Paper ID
  lines.push(['BY PAPER ID', 'Paper Title', ...metricHeaders].join(','));
  paperNums.forEach(paperNum => {
    const title = paperGroupTitleFull[paperNum] || '';
    const row = [`Paper ${paperNum}`, JSON.stringify(title), ...active.map(m => {
      const v = paperGroupResults[paperNum][m];
      return v !== null ? (m==='pairwise'?(v*100).toFixed(1)+'%':v.toFixed(4)) : 'N/A';
    })];
    lines.push(row.join(','));
  });
  // AVERAGE row from paperGroupResults
  lines.push(['AVERAGE', '', ...active.map(m => {
    const v = overallAvg[m];
    return v !== null ? (m==='pairwise'?(v*100).toFixed(1)+'%':v.toFixed(4)) : 'N/A';
  })].join(','));

  dlBlob(new Blob([lines.join('\n')],{type:'text/csv'}), 'irr_results.csv');
}

function exportXLSX() {
  if (!lastResults) return;
  const {paperGroupResults, paperGroupTitleFull,
         metrics, metricErrors} = lastResults;
  const active = metrics.filter(m=>!metricErrors[m].length);

  const paperNums = Object.keys(paperGroupResults).sort((a,b)=>{
    const na=parseFloat(a),nb=parseFloat(b); return isNaN(na)||isNaN(nb)?a.localeCompare(b):na-nb;
  });

  // Overall = average of paperGroupResults (matches display)
  const overallAvg = {};
  active.forEach(m => {
    const vals = paperNums.map(p=>paperGroupResults[p][m]).filter(v=>v!==null);
    overallAvg[m] = vals.length ? avg(vals) : null;
  });

  const wb = XLSX.utils.book_new();
  const wsData = [];

  // ── OVERALL SUMMARY ──
  wsData.push(['OVERALL SUMMARY', ...active.map(m => METRIC_LABELS[m])]);
  wsData.push(['Overall IRR', ...active.map(m => {
    const v = overallAvg[m];
    return v !== null ? (m==='pairwise' ? parseFloat((v*100).toFixed(1)) : parseFloat(v.toFixed(4))) : 'N/A';
  })]);
  wsData.push([]);

  // ── BY PAPER ID ──
  wsData.push(['BY PAPER ID', 'Paper Title', ...active.map(m => METRIC_LABELS[m])]);
  paperNums.forEach(paperNum => {
    const title = paperGroupTitleFull[paperNum] || '';
    wsData.push([
      `Paper ${paperNum}`,
      title,
      ...active.map(m => {
        const v = paperGroupResults[paperNum][m];
        return v !== null ? (m==='pairwise' ? parseFloat((v*100).toFixed(1)) : parseFloat(v.toFixed(4))) : 'N/A';
      })
    ]);
  });
  const avgRow = ['AVERAGE', '', ...active.map(m => {
    const v = overallAvg[m];
    return v !== null ? (m==='pairwise' ? parseFloat((v*100).toFixed(1)) : parseFloat(v.toFixed(4))) : 'N/A';
  })];
  wsData.push(avgRow);

  const ws = XLSX.utils.aoa_to_sheet(wsData);
  const totalCols = 2 + active.length;

  ws['!cols'] = [
    { wch: 14 },
    { wch: 55 },
    ...active.map(() => ({ wch: 18 }))
  ];

  // Style all cells
  const range = XLSX.utils.decode_range(ws['!ref']);
  for (let R = range.s.r; R <= range.e.r; R++) {
    for (let C = range.s.c; C <= range.e.c; C++) {
      const addr = XLSX.utils.encode_cell({r:R, c:C});
      if (!ws[addr]) continue;
      const isOverallHeader = R === 0;
      const isOverallData   = R === 1;
      const isPaperHeader   = R === 3;
      const isAverageRow    = R === wsData.length - 1;
      const isPaperData     = R >= 4 && R < wsData.length - 1;

      ws[addr].s = {
        font: {
          name: 'Calibri', sz: isOverallHeader || isPaperHeader ? 11 : 10,
          bold: isOverallHeader || isPaperHeader || isOverallData || isAverageRow,
          color: { rgb: isOverallHeader || isPaperHeader ? 'FFFFFF' : '1A1A2E' }
        },
        fill: {
          patternType: 'solid',
          fgColor: { rgb:
            isOverallHeader ? '4A5FA8' :
            isPaperHeader   ? '2E3550' :
            isOverallData   ? 'E8ECF8' :
            isAverageRow    ? 'D0D5E8' :
            isPaperData && R % 2 === 0 ? 'F5F6FA' : 'FFFFFF'
          }
        },
        alignment: {
          horizontal: C >= 2 ? 'center' : 'left',
          vertical: 'center',
          wrapText: C === 1
        },
        border: {
          bottom: { style: 'thin', color: { rgb: 'C5CAD8' } },
          right:  { style: 'thin', color: { rgb: 'C5CAD8' } }
        }
      };

      // Color-code metric values
      if (C >= 2 && (isPaperData || isOverallData) && ws[addr].t === 'n') {
        const m = active[C - 2];
        const normVal = m === 'pairwise' ? ws[addr].v / 100 : ws[addr].v;
        const color = normVal >= 0.8 ? '1A7A4A' : normVal >= 0.6 ? 'B45309' : 'B91C1C';
        ws[addr].s.font.color = { rgb: color };
        ws[addr].s.font.bold = true;
      }
    }
  }

  ws['!merges'] = [
    { s:{r:0,c:0}, e:{r:0,c:totalCols-1} },
    { s:{r:3,c:0}, e:{r:3,c:0} },
  ];

  XLSX.utils.book_append_sheet(wb, ws, 'IRR Results');
  XLSX.writeFile(wb, 'irr_results.xlsx');
}

function dlBlob(blob, name) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href=url; a.download=name; a.click(); URL.revokeObjectURL(url);
}

// ── Tooltip positioning ──
document.addEventListener('mouseover', e => {
  const tip = e.target.closest('.info-tooltip');
  if (!tip) return;
  const body = tip.querySelector('.tooltip-body');
  if (!body) return;
  const rect = tip.getBoundingClientRect();
  const left = Math.max(10, Math.min(rect.left + rect.width/2, window.innerWidth - 160));
  body.style.left = left + 'px';
  body.style.top = (rect.bottom + 8) + 'px';
});
