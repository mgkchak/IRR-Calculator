// ═══════════════════════════════════════════
// RUN
// ═══════════════════════════════════════════
document.getElementById('runBtn').addEventListener('click', () => {
  const paperCol = document.getElementById('paperCol').value;
  const coderCol = document.getElementById('coderCol').value;
  const cols = [...selectedCols];
  const metrics = getSelectedMetrics();

  const errors = [];
  if (!paperCol) errors.push('Please select a Paper/Item ID column.');
  if (cols.length === 0) errors.push('Please select at least one coding column.');
  if (metrics.length === 0) errors.push('Please select at least one metric.');
  if (errors.length) { showResults(null, errors, []); return; }

  let wideData = coderCol
    ? parseLong(rawData, paperCol, coderCol, cols)
    : parseWide(rawData, paperCol, cols);

  const filterOn = document.getElementById('filterCoders').checked;
  if (filterOn) {
    const allowed = new Set([...document.querySelectorAll('.coder-check:checked')].map(el => el.value));
    Object.keys(wideData).forEach(pid => {
      wideData[pid] = Object.fromEntries(Object.entries(wideData[pid]).filter(([cid]) => allowed.has(cid)));
    });
  }

  const papers = Object.keys(wideData);
  const coders = [...new Set(papers.flatMap(p => Object.keys(wideData[p])))];
  const nCoders = coders.length;

  const metricErrors = {}, metricWarnings = {};
  metrics.forEach(m => {
    metricErrors[m] = []; metricWarnings[m] = [];
    if (m === 'cohen' && nCoders !== 2)
      metricErrors[m].push(`Cohen's Kappa requires exactly 2 coders. Found ${nCoders}: ${coders.join(', ')}.`);
    if (m === 'fleiss' && nCoders < 3)
      metricErrors[m].push(`Fleiss' Kappa requires 3+ coders. Found ${nCoders}.`);
    if (m === 'pairwise') {
      const nP = (nCoders*(nCoders-1))/2;
      if (nP > 45) metricWarnings[m].push(`${nCoders} coders → ${nP} pairs. Displaying aggregated results.`);
    }
  });

  const rqResults = {};
  cols.forEach(col => {
    rqResults[col] = {};
    metrics.forEach(m => {
      rqResults[col][m] = metricErrors[m].length ? null : calcMetric(m, wideData, papers, coders, col);
    });
  });

  const paperResults = {};
  papers.forEach(pid => {
    paperResults[pid] = {};
    metrics.forEach(m => {
      if (metricErrors[m].length) { paperResults[pid][m] = null; return; }
      const vals = cols.map(c => calcMetric(m, {[pid]: wideData[pid]}, [pid], coders, c)).filter(v => v !== null);
      paperResults[pid][m] = vals.length ? avg(vals) : null;
    });
  });

  lastResults = { rqResults, paperResults, cols, papers, coders, metrics, metricErrors, metricWarnings, _wide: wideData };
  showResults(lastResults, [], []);
});

function getSelectedMetrics() {
  return [...document.querySelectorAll('[data-metric]')].filter(el => el.checked).map(el => el.dataset.metric);
}

// ═══════════════════════════════════════════
// DATA PARSING
// ═══════════════════════════════════════════
function parseLong(data, paperCol, coderCol, cols) {
  const wide = {};
  data.forEach(row => {
    const pid = String(row[paperCol]);
    const cid = String(row[coderCol]);
    if (!wide[pid]) wide[pid] = {};
    if (!wide[pid][cid]) wide[pid][cid] = {};
    cols.forEach(c => { wide[pid][cid][c] = row[c]; });
  });
  return wide;
}

function parseWide(data, paperCol, cols) {
  const wide = {};
  data.forEach(row => {
    const pid = String(row[paperCol]);
    if (!wide[pid]) wide[pid] = {};
    cols.forEach(c => {
      if (!wide[pid][c]) wide[pid][c] = {};
      wide[pid][c][c] = row[c];
    });
  });
  return wide;
}

// ═══════════════════════════════════════════
// IRR MATH
// ═══════════════════════════════════════════
function avg(arr) { return arr.reduce((a,b) => a+b, 0)/arr.length; }

function calcMetric(metric, wideData, papers, coders, col) {
  const matrix = coders.map(coder =>
    papers.map(paper => {
      const v = wideData[paper]?.[coder]?.[col];
      return (v === '' || v == null) ? null : v;
    })
  );
  if (metric === 'alpha')    return krippendorffAlpha(matrix, colTypes[col] || 'nominal');
  if (metric === 'pairwise') return pairwiseAgreement(matrix);
  if (metric === 'cohen')    return cohensKappa(matrix);
  if (metric === 'fleiss')   return fleissKappa(matrix, papers);
  return null;
}

function pairwiseAgreement(matrix) {
  const n = matrix[0].length;
  const pairs = [];
  for (let i = 0; i < matrix.length; i++) {
    for (let j = i+1; j < matrix.length; j++) {
      let agree = 0, total = 0;
      for (let k = 0; k < n; k++) {
        const a = matrix[i][k], b = matrix[j][k];
        if (a !== null && b !== null) { total++; if (String(a) === String(b)) agree++; }
      }
      if (total > 0) pairs.push(agree/total);
    }
  }
  return pairs.length ? avg(pairs) : null;
}

function cohensKappa(matrix) {
  if (matrix.length !== 2) return null;
  const [a, b] = matrix;
  const n = a.length;
  const cats = [...new Set([...a,...b].filter(v=>v!==null).map(String))];
  const valid = a.map((v,i) => v!==null && b[i]!==null);
  const N = valid.filter(Boolean).length;
  if (N === 0 || cats.length === 0) return null;
  let po = 0;
  for (let i = 0; i < n; i++) if (valid[i] && String(a[i])===String(b[i])) po++;
  po /= N;
  let pe = 0;
  cats.forEach(c => {
    const pa = a.filter((v,i)=>valid[i]&&String(v)===c).length/N;
    const pb = b.filter((v,i)=>valid[i]&&String(v)===c).length/N;
    pe += pa*pb;
  });
  return pe >= 1 ? 1 : (po-pe)/(1-pe);
}

function fleissKappa(matrix, papers) {
  const nR = matrix.length, nI = papers.length;
  const catSet = new Set();
  matrix.forEach(row => row.forEach(v => { if (v!==null) catSet.add(String(v)); }));
  const cats = [...catSet];
  if (!cats.length) return null;

  const nij = papers.map((_,i) => {
    const counts = Object.fromEntries(cats.map(c=>[c,0]));
    matrix.forEach(row => { if (row[i]!==null) { const s=String(row[i]); if(counts[s]!==undefined) counts[s]++; } });
    return counts;
  });
  const ni = nij.map(row => Object.values(row).reduce((a,b)=>a+b,0));
  const N = ni.reduce((a,b)=>a+b,0);
  if (!N) return null;

  const Pi = nij.map((row,i) => {
    const t = ni[i]; if (t<=1) return 0;
    return cats.reduce((acc,c)=>acc+row[c]*(row[c]-1),0)/(t*(t-1));
  });
  const Pbar = avg(Pi);
  const Pj = cats.map(c => nij.reduce((acc,row)=>acc+row[c],0)/N);
  const Pe = Pj.reduce((acc,p)=>acc+p*p,0);
  return Pe>=1 ? 1 : (Pbar-Pe)/(1-Pe);
}

function krippendorffAlpha(matrix, dataType) {
  const nI = matrix[0].length;
  const values = [];
  matrix.forEach((row,o) => row.forEach((v,i) => {
    if (v!==null) values.push({o,i,v:parseVal(v)});
  }));
  if (values.length < 2) return null;

  const allVals = [...new Set(values.map(d=>d.v))].sort((a,b)=>a>b?1:-1);
  const coincidences = {}, mu = {};
  allVals.forEach(v => mu[v]=0);
  let totalPairs = 0;

  for (let i = 0; i < nI; i++) {
    const iv = values.filter(d=>d.i===i);
    const n = iv.length; if (n<2) continue;
    for (let a = 0; a < iv.length; a++) {
      for (let b = 0; b < iv.length; b++) {
        if (a===b) continue;
        const va=iv[a].v, vb=iv[b].v, w=1/(n-1);
        const key=`${va}__${vb}`;
        coincidences[key]=(coincidences[key]||0)+w;
        mu[va]=(mu[va]||0)+w;
        totalPairs+=w;
      }
    }
  }
  if (!totalPairs) return null;

  let Do=0;
  allVals.forEach(vk=>allVals.forEach(vl=>{
    Do+=delta(vk,vl,dataType,allVals)*(coincidences[`${vk}__${vl}`]||0);
  }));
  Do/=totalPairs;

  const muTotal=Object.values(mu).reduce((a,b)=>a+b,0);
  let De=0;
  allVals.forEach(vk=>allVals.forEach(vl=>{
    De+=delta(vk,vl,dataType,allVals)*(mu[vk]||0)*(mu[vl]||0);
  }));
  De/=(muTotal*(muTotal-1));

  return De===0 ? 1 : 1-Do/De;
}

function parseVal(v) { const n=Number(v); return isNaN(n)?String(v):n; }

function delta(vk,vl,dataType,allVals) {
  if (String(vk)===String(vl)) return 0;
  if (dataType==='nominal') return 1;
  if (dataType==='ordinal') {
    const ki=allVals.indexOf(vk),li=allVals.indexOf(vl);
    if (ki===-1||li===-1) return 1;
    return Math.pow(Math.abs(ki-li),2);
  }
  const nk=Number(vk),nl=Number(vl);
  return (isNaN(nk)||isNaN(nl)) ? 1 : Math.pow(nk-nl,2);
}

// ═══════════════════════════════════════════
// DISPLAY
// ═══════════════════════════════════════════
const METRIC_LABELS = {
  alpha:"Krippendorff's α", pairwise:'Pairwise %', cohen:"Cohen's κ", fleiss:"Fleiss' κ"
};

function fmtVal(v, isP) {
  if (v===null||v===undefined) return '<span class="val-na">—</span>';
  const n = isP ? v*100 : v;
  const cls = n>=(isP?80:0.8)?'val-good':n>=(isP?60:0.6)?'val-fair':'val-poor';
  return `<span class="${cls}">${n.toFixed(isP?1:3)}${isP?'%':''}</span>`;
}
function scoreClass(v) { return v===null?'na':v>=0.8?'good':v>=0.6?'fair':'poor'; }
function scoreInterp(v) {
  if (v===null) return 'N/A';
  return v>=0.8?'● Strong':v>=0.6?'◐ Moderate':'○ Low';
}

function showResults(res, errors, warnings) {
  const area = document.getElementById('resultsArea');
  document.getElementById('emptyState').classList.add('hidden');
  area.classList.remove('hidden');
  area.innerHTML = '';

  errors.forEach(e => area.innerHTML += banner('error','✖',e));
  if (!res) return;

  const {rqResults,paperResults,cols,papers,coders,metrics,metricErrors,metricWarnings,_wide} = res;
  metrics.forEach(m => {
    metricErrors[m].forEach(e => area.innerHTML += banner('error','✖',`<strong>${METRIC_LABELS[m]}:</strong> ${e}`));
    metricWarnings[m].forEach(w => area.innerHTML += banner('warn','⚠',`<strong>${METRIC_LABELS[m]}:</strong> ${w}`));
  });

  const active = metrics.filter(m => !metricErrors[m].length);
  const vName = activeVersion ? SHEET_VERSIONS[activeVersion].name : '';
  const ts = new Date().toLocaleString();

  area.innerHTML += `
    <div class="results-header">
      <div>
        <div class="results-title">IRR Results</div>
        <div class="results-meta">${vName ? vName+' · ' : ''}${papers.length} papers · ${cols.length} variables · ${coders.length} coders · ${ts}</div>
      </div>
      <div class="export-btns">
        <button class="export-btn" onclick="exportCSV()">⬇ Export CSV</button>
        <button class="export-btn" onclick="exportXLSX()">⬇ Export Excel</button>
      </div>
    </div>`;

  if (!active.length) return;

  // Summary cards
  const sb = document.createElement('div'); sb.className = 'metric-block';
  let sh = '<div class="metric-block-header"><span class="metric-block-title">Overall Summary</span><span class="metric-block-sub">Averaged across all variables & papers</span></div><div class="score-row">';
  active.forEach(m => {
    const vals = cols.map(c=>rqResults[c][m]).filter(v=>v!==null);
    const ov = vals.length ? avg(vals) : null;
    const isP = m==='pairwise';
    const disp = ov!==null ? (isP?(ov*100).toFixed(1)+'%':ov.toFixed(3)) : '—';
    sh += `<div class="score-cell">
      <span class="score-value ${scoreClass(ov)}">${disp}</span>
      <span class="score-label">${METRIC_LABELS[m]}</span>
      <span class="score-interp">${scoreInterp(ov)}</span>
    </div>`;
  });
  sh += '</div>'; sb.innerHTML = sh; area.appendChild(sb);

  // RQ table
  const rb = document.createElement('div'); rb.className = 'metric-block';
  let rh = `<div class="section-header">Variable-Level Results <span class="pill">${cols.length} coding variables</span></div>
    <div class="rq-table-wrap"><table>
    <thead><tr><th>Variable</th><th>Type</th>${active.map(m=>`<th>${METRIC_LABELS[m]}</th>`).join('')}</tr></thead><tbody>`;
  cols.forEach(col => {
    const tm = {nominal:'NOM',ordinal:'ORD',interval:'INT'};
    const tc = {nominal:'nom',ordinal:'ord',interval:'int'};
    const t = colTypes[col]||'nominal';
    rh += `<tr><td style="font-family:var(--mono);max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${col}">${col}</td>
      <td><span class="col-type-badge ${tc[t]}">${tm[t]||t}</span></td>
      ${active.map(m=>`<td>${fmtVal(rqResults[col][m],m==='pairwise')}</td>`).join('')}</tr>`;
  });
  const avgVals = active.map(m => { const v=cols.map(c=>rqResults[c][m]).filter(v=>v!==null); return v.length?avg(v):null; });
  rh += `<tr style="background:var(--surface3)"><td style="font-weight:600;font-family:var(--mono)">AVERAGE</td><td>—</td>${avgVals.map((v,i)=>`<td>${fmtVal(v,active[i]==='pairwise')}</td>`).join('')}</tr>`;
  rh += '</tbody></table></div>'; rb.innerHTML = rh; area.appendChild(rb);

  // Paper table
  const pb = document.createElement('div'); pb.className = 'metric-block';
  let ph = `<div class="section-header">Paper-Level Results <span class="pill">averaged across variables per paper</span></div>
    <div class="rq-table-wrap"><table>
    <thead><tr><th>Paper ID</th>${active.map(m=>`<th>${METRIC_LABELS[m]}</th>`).join('')}</tr></thead><tbody>`;
  papers.forEach(pid => {
    ph += `<tr><td style="font-family:var(--mono)">${pid}</td>${active.map(m=>`<td>${fmtVal(paperResults[pid][m],m==='pairwise')}</td>`).join('')}</tr>`;
  });
  const papAvg = active.map(m => { const v=papers.map(p=>paperResults[p][m]).filter(v=>v!==null); return v.length?avg(v):null; });
  ph += `<tr style="background:var(--surface3)"><td style="font-weight:600;font-family:var(--mono)">AVERAGE</td>${papAvg.map((v,i)=>`<td>${fmtVal(v,active[i]==='pairwise')}</td>`).join('')}</tr>`;
  ph += '</tbody></table></div>'; pb.innerHTML = ph; area.appendChild(pb);

  // Pairwise detail
  if (active.includes('pairwise') && coders.length >= 2) {
    const pairs = [];
    for (let i=0;i<coders.length;i++) for (let j=i+1;j<coders.length;j++) pairs.push([coders[i],coders[j]]);
    const pairBlock = document.createElement('div'); pairBlock.className = 'metric-block';
    let pairH = `<div class="section-header">Pairwise Agreement Detail <span class="pill">${pairs.length} pair${pairs.length>1?'s':''}</span></div>
      <div class="rq-table-wrap"><table>
      <thead><tr><th>Pair</th>${cols.map(c=>`<th title="${c}">${c.length>14?c.slice(0,12)+'…':c}</th>`).join('')}<th>Avg</th></tr></thead><tbody>`;

    pairs.forEach(([ca,cb]) => {
      const colVals = cols.map(col => {
        const mat = [[],[]];
        papers.forEach(p => {
          mat[0].push(_wide[p]?.[ca]?.[col]??null);
          mat[1].push(_wide[p]?.[cb]?.[col]??null);
        });
        return pairwiseAgreement(mat);
      });
      const rowAvg = colVals.filter(v=>v!==null).length ? avg(colVals.filter(v=>v!==null)) : null;
      pairH += `<tr><td><span class="pair-badge">👤 ${ca} × ${cb}</span></td>${colVals.map(v=>`<td>${fmtVal(v,true)}</td>`).join('')}<td>${fmtVal(rowAvg,true)}</td></tr>`;
    });
    pairH += '</tbody></table></div>'; pairBlock.innerHTML = pairH; area.appendChild(pairBlock);
  }
}

function banner(type,icon,msg) {
  return `<div class="banner ${type}"><span class="banner-icon">${icon}</span><span>${msg}</span></div>`;
}

// ═══════════════════════════════════════════
// EXPORT
// ═══════════════════════════════════════════
function buildExportRows() {
  if (!lastResults) return [];
  const {rqResults,paperResults,cols,papers,metrics,metricErrors} = lastResults;
  const active = metrics.filter(m=>!metricErrors[m].length);
  const rows = [];

  cols.forEach(col => {
    const row = {Level:'Variable', ID:col, DataType:colTypes[col]||'nominal'};
    active.forEach(m => {
      const v = rqResults[col][m];
      row[METRIC_LABELS[m]] = v!==null ? (m==='pairwise'?(v*100).toFixed(1)+'%':v.toFixed(4)) : 'N/A';
    });
    rows.push(row);
  });

  const avgRQ = {Level:'Variable',ID:'AVERAGE',DataType:''};
  active.forEach(m => {
    const v2 = cols.map(c=>rqResults[c][m]).filter(v=>v!==null);
    avgRQ[METRIC_LABELS[m]] = v2.length ? (m==='pairwise'?(avg(v2)*100).toFixed(1)+'%':avg(v2).toFixed(4)) : 'N/A';
  });
  rows.push(avgRQ); rows.push({});

  papers.forEach(pid => {
    const row = {Level:'Paper',ID:pid,DataType:''};
    active.forEach(m => {
      const v = paperResults[pid][m];
      row[METRIC_LABELS[m]] = v!==null ? (m==='pairwise'?(v*100).toFixed(1)+'%':v.toFixed(4)) : 'N/A';
    });
    rows.push(row);
  });
  const avgP = {Level:'Paper',ID:'AVERAGE',DataType:''};
  active.forEach(m => {
    const v2 = papers.map(p=>paperResults[p][m]).filter(v=>v!==null);
    avgP[METRIC_LABELS[m]] = v2.length ? (m==='pairwise'?(avg(v2)*100).toFixed(1)+'%':avg(v2).toFixed(4)) : 'N/A';
  });
  rows.push(avgP);
  return rows;
}

function exportCSV() {
  const rows = buildExportRows(); if (!rows.length) return;
  const keys = Object.keys(rows.find(r=>Object.keys(r).length>0));
  const lines = [keys.join(','), ...rows.map(r=>keys.map(k=>JSON.stringify(r[k]??'')).join(','))];
  dlBlob(new Blob([lines.join('\n')],{type:'text/csv'}), 'irr_results.csv');
}

function exportXLSX() {
  const rows = buildExportRows();
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rows), 'IRR Results');
  XLSX.writeFile(wb, 'irr_results.xlsx');
}

function dlBlob(blob, name) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href=url; a.download=name; a.click(); URL.revokeObjectURL(url);
}
