function buildColumnSelectors(versionKey) {
  const paperSel = document.getElementById('paperCol');
  const coderSel = document.getElementById('coderCol');
  paperSel.innerHTML = '';
  coderSel.innerHTML = '<option value="">(Wide format — coders are columns)</option>';

  allColumns.forEach(c => {
    paperSel.innerHTML += `<option value="${esc(c)}">${c}</option>`;
    coderSel.innerHTML += `<option value="${esc(c)}">${c}</option>`;
  });

  // Paper col heuristic
  const paperHint = allColumns.find(c => /paper|article|^id$|item|doi|title|zotero/i.test(c));
  if (paperHint) paperSel.value = paperHint;

  // Coder col: default to "Reviewer" if present, else heuristic
  const reviewerCol = allColumns.find(c => c === 'Reviewer');
  const coderHint = reviewerCol || allColumns.find(c => /coder|reviewer|rater/i.test(c));
  if (coderHint) coderSel.value = coderHint; else coderSel.value = '';

  buildColPicker(versionKey);
  buildCoderList();

  paperSel.onchange = () => buildColPicker(activeVersion);
  coderSel.onchange = () => { buildColPicker(activeVersion); buildCoderList(); };

  document.getElementById('selectAllBtn').onclick = () => {
    document.querySelectorAll('.col-check').forEach(cb => {
      if (!cb.checked) { cb.checked = true; cb.dispatchEvent(new Event('change')); }
    });
  };
  document.getElementById('clearAllBtn').onclick = () => {
    document.querySelectorAll('.col-check').forEach(cb => {
      if (cb.checked) { cb.checked = false; cb.dispatchEvent(new Event('change')); }
    });
  };
}

function buildColPicker(versionKey) {
  const paperCol = document.getElementById('paperCol').value;
  const coderCol = document.getElementById('coderCol').value;
  const exclude = new Set([paperCol, coderCol].filter(Boolean));

  // Determine which cols to pre-select
  const versionCols = versionKey && SHEET_VERSIONS[versionKey]
    ? new Set(SHEET_VERSIONS[versionKey].cols) : new Set();

  // Filter: only pre-check cols that are in the version definition AND present in the file
  // AND: for metric columns, only if at least one coder has a non-empty value
  const metricsWithData = versionKey ? getMetricColsWithData(versionKey, coderCol, paperCol) : new Set(allColumns);

  const picker = document.getElementById('colPicker');
  picker.innerHTML = '';
  selectedCols.clear();

  allColumns.filter(c => !exclude.has(c)).forEach(c => {
    const type = colTypes[c] || 'nominal';
    const isMetricCol = /^Metric\d+-/.test(c);
    const shouldPreCheck = versionCols.has(c) &&
      (!isMetricCol || metricsWithData.has(c));

    const wrap = document.createElement('div');

    const item = document.createElement('label');
    item.className = 'col-item';
    item.innerHTML = `
      <input type="checkbox" class="col-check" data-col="${esc(c)}" ${shouldPreCheck ? 'checked' : ''}>
      <span class="col-name" title="${esc(c)}">${c.length > 28 ? c.slice(0,26)+'…' : c}</span>
      <span class="col-type-badge ${type.slice(0,3)}">${type.slice(0,3).toUpperCase()}</span>
    `;

    const typeRow = document.createElement('div');
    typeRow.className = `col-type-selector${shouldPreCheck ? ' visible' : ''}`;
    ['nominal','ordinal','interval'].forEach(t => {
      const btn = document.createElement('button');
      btn.className = `type-btn ${type === t ? 'active-'+t.slice(0,3) : ''}`;
      btn.textContent = t; btn.dataset.type = t;
      btn.addEventListener('click', e => {
        e.preventDefault();
        colTypes[c] = t;
        typeRow.querySelectorAll('.type-btn').forEach(b => {
          b.className = `type-btn ${b.dataset.type === t ? 'active-'+t.slice(0,3) : ''}`;
        });
        item.querySelector('.col-type-badge').className = `col-type-badge ${t.slice(0,3)}`;
        item.querySelector('.col-type-badge').textContent = t.slice(0,3).toUpperCase();
      });
      typeRow.appendChild(btn);
    });

    if (shouldPreCheck) selectedCols.add(c);

    item.querySelector('.col-check').addEventListener('change', function() {
      if (this.checked) { selectedCols.add(c); typeRow.classList.add('visible'); }
      else { selectedCols.delete(c); typeRow.classList.remove('visible'); }
      updatePickerCount();
    });

    wrap.appendChild(item); wrap.appendChild(typeRow); picker.appendChild(wrap);
  });

  updatePickerCount();
}

// For metric columns: only include if at least one row has a non-empty value for that column
function getMetricColsWithData(versionKey, coderCol, paperCol) {
  const result = new Set();
  const vDef = SHEET_VERSIONS[versionKey];
  if (!vDef) return result;

  vDef.cols.forEach(col => {
    if (!/^Metric\d+-/.test(col)) {
      result.add(col); // always include non-metric cols
      return;
    }
    // Check if any row has a non-empty value
    const hasData = rawData.some(row => {
      const v = row[col];
      return v !== undefined && v !== null && String(v).trim() !== '';
    });
    if (hasData) result.add(col);
  });

  return result;
}

function updatePickerCount() {
  document.getElementById('pickerCount').textContent = `${selectedCols.size} selected`;
}

function buildCoderList() {
  const coderCol = document.getElementById('coderCol').value;
  const coderMulti = document.getElementById('coderMulti');
  coderMulti.innerHTML = '';

  let coders = [];
  if (coderCol) {
    coders = [...new Set(rawData.map(r => String(r[coderCol])).filter(Boolean))];
  }

  coders.forEach(coder => {
    const label = document.createElement('label');
    label.className = 'col-item';
    label.style.padding = '5px 6px';
    label.innerHTML = `<input type="checkbox" class="coder-check" value="${esc(coder)}" checked>
      <span class="col-name">${coder}</span>`;
